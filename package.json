{
  "name": "org-roam-to-obsidian",
  "version": "3.0.0",
  "description": "Convert org-roam notes to Obsidian markdown format",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "markdownlint-cli": "0.43.0",
    "prettier": "3.9.6"
  },
  "scripts": {
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore output --ignore CHANGELOG.md",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore output --ignore CHANGELOG.md --fix",
    "lint:yaml": "prettier --check '**/*.{yml,yaml}' --ignore-path .gitignore",
    "lint:yaml:fix": "prettier --write '**/*.{yml,yaml}' --ignore-path .gitignore",
    "lint:json": "prettier --check '**/*.json' --ignore-path .gitignore",
    "lint:json:fix": "prettier --write '**/*.json' --ignore-path .gitignore"
  }
}
