{
  "name": "org-roam-to-obsidian",
  "version": "3.1.1",
  "description": "Convert org-roam notes to Obsidian markdown format",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "scripts": {
    "format:md": "prettier --check '**/*.md'",
    "format:md:fix": "prettier --write '**/*.md'",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:prose": "vale --glob='!{.venv/**,node_modules/**,output/**,styles/**,CHANGELOG.md}' .",
    "lint:yaml": "prettier --check '**/*.{yml,yaml}'",
    "lint:yaml:fix": "prettier --write '**/*.{yml,yaml}'",
    "lint:json": "prettier --check '**/*.{json,jsonc}'",
    "lint:json:fix": "prettier --write '**/*.{json,jsonc}'"
  }
}
